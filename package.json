{
  "name": "zare-repo",
  "version": "0.0.0",
  "private": true,
  "description": "A file base component template engine",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs:start": "npm run -w zare-docs dev",
    "docs:build": "npm run -w zare-docs build",
    "cli:start": "npm run -w @zarejs/cli dev",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "licenses": "node scripts/copy-licenses.js",
    "prepare": "husky",
    "changeset": "changeset",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@manypkg/get-packages": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "commitlint": "^21.2.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.0.3"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "packageManager": "npm@11.4.2"
}
